<?xml version="1.0"?>

<launch>

  <arg name="building_map_path"/>
  <arg name="nav_graph_path"/>
  <arg name="viz_config_file"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="map_name" default="L1"/>
  <arg name="server_uri" default="ws://localhost:8000/_internal"/>

  <!-- Common launch -->
  <node pkg="rmf_traffic_ros2"
        exec="rmf_traffic_schedule"
        name="rmf_traffic_schedule_primary"
        output="both">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="rmf_building_map_tools"
        exec="building_map_server"
        args="$(var building_map_path)"
        output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="rmf_traffic_ros2"
        exec="rmf_traffic_blockade"
        output="both">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <include file="$(find-pkg-share rmf_visualization)/visualization.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="map_name" value="$(var map_name)"/>
    <arg name="viz_config_file" value="$(var viz_config_file)"/>
  </include>

  <node pkg="rmf_fleet_adapter"
        exec="door_supervisor"
        output="both">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="rmf_fleet_adapter"
        exec="lift_supervisor"
        output="both">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="rmf_task_ros2"
        exec="rmf_task_dispatcher"
        output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="bidding_time_window" value="2.0"/>
    <param name="use_unique_hex_string_with_task_id" value="true"/>
    <param name="server_uri" value="$(var server_uri)"/>
  </node>

  <!-- Fleet adapter -->
  <group if="$(var use_sim_time)">
    <node pkg="oro_fleet_adapter"
          exec="fleet_adapter"
          args="-c $(find-pkg-share oro_fleet_adapter)/demo.andino.config.yaml -n $(var nav_graph_path) -sim"
          output="both">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="server_uri" value="$(var server_uri)"/>
    </node>
  </group>

  <group unless="$(var use_sim_time)">
    <node pkg="oro_fleet_adapter"
          exec="fleet_adapter"
          args="-c $(find-pkg-share oro_fleet_adapter)/demo.andino.config.yaml -n $(var nav_graph_path)"
          output="both">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="server_uri" value="$(var server_uri)"/>
    </node>
  </group>

</launch>